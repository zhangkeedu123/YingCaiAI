
<ui:ContentDialog
   x:Class="YingCaiAiWin.Views.Pages.AddCustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:local="clr-namespace:YingCaiAiWin.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Terms of use"
    d:DesignHeight="600"
    d:DesignWidth="750"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    CloseButtonText="Close"
    DialogMaxWidth="750"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:AddCustomerDialog}" />
    </ui:ContentDialog.Resources>

    <Grid Margin="10" Width="500" Height="530">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 用户名 -->
        <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="公司名称:" />
        <TextBox Grid.Row="0" Grid.Column="1" Height="40" Margin="0,4" x:Name="Name"   />
        <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="公司地区:" />
        <TextBox Grid.Row="1" Grid.Column="1" Height="40" Margin="0,4" x:Name="Area"   />
        <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="联系人:" />
        <TextBox Grid.Row="2" Grid.Column="1" Height="40" Margin="0,4" x:Name="Contacts"   />
        <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="联系电话:" />
        <TextBox Grid.Row="3" Grid.Column="1" Height="40" Margin="0,4" x:Name="Phone"   />
        <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="公司性质:" />
        <TextBox Grid.Row="4" Grid.Column="1" Height="40" Margin="0,4" x:Name="CoProperty"   />
        <TextBlock Grid.Row="5" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="公司规模:" />
        <TextBox Grid.Row="5" Grid.Column="1" Height="40" Margin="0,4" x:Name="CoSize"   />
        <TextBlock Grid.Row="6" Grid.Column="0" FontFamily="block"  FontWeight="Black"   VerticalAlignment="Center" Text="介绍:" />
        <TextBox  Grid.Row="6" Grid.Column="1"
                x:Name="Intro" 
                TextWrapping="Wrap"
                FontSize="14"
                  Padding="10"
                Foreground="Black"
                Height="170"
                Width="400"
                IsReadOnly="False"
                VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Top"
                  AcceptsReturn="True"
                 AcceptsTab="True"
            />
        <ui:InfoBar Title="错误"   Grid.Row="7" Grid.Column="1" Height="80" x:Name="ErrorInfoBar"  Message="" IsOpen="False"  Severity="Error"  />
    </Grid>


    </ui:ContentDialog>
